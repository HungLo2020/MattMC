{
  "schemaVersion" : 1,
  "id" : "sodium",
  "version" : "${version}",
  "name" : "Sodium",
  "description" : "Advanced rendering engine integrated into MattMC for improved performance",
  "license" : "Polyform-Shield-1.0.0",
  "icon" : "sodium-icon.png",
  "environment" : "client",
  "entrypoints" : {
    "client" : [
      "net.caffeinemc.mods.sodium.fabric.SodiumFabricMod"
    ],
