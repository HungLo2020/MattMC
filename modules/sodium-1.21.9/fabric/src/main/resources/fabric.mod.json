      "net.caffeinemc.mods.sodium.fabric.SodiumPreLaunch"
    ]
  },
  "custom" : {
    "fabric-renderer-api-v1:contains_renderer" : true
  },
  "mixins" : [
    "sodium-common.mixins.json",
    "sodium-fabric.mixins.json"
  ]
}
