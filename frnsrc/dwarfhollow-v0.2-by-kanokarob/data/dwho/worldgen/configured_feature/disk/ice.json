{
  "type": "minecraft:disk",
  "config": {
    "state_provider": {
      "fallback": {
        "type": "minecraft:simple_state_provider",
        "state": {
          "Name": "minecraft:snow_block"
        }
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_blocks",
            "blocks": [
              "minecraft:snow_block",
              "minecraft:packed_ice",
              "minecraft:blue_ice"
            ]
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:ice"
            }
          }
        }
      ]
    },
    "radius": {
      "type": "minecraft:uniform",
      "min_inclusive": 3,
      "max_inclusive": 5
    },
    "half_height": 0,
    "target": {
      "type": "minecraft:matching_blocks",
      "blocks": [
        "minecraft:snow_block",
        "minecraft:packed_ice",
        "minecraft:blue_ice"
      ]
    }
  }
}